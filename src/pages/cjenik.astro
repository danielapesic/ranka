---
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import CtaBanner from '../components/CtaBanner.astro'
import StickyCallButton from '../components/StickyCallButton.astro'

import cjenik from '../data/cjenik.json'
import { formatCijena, formatDatum } from '../lib/cjenik.mjs'

const categories = cjenik.kategorije
const sidreniDatum = formatDatum(cjenik.sidreni_datum)
---
<Layout
  title="Cjenik — Salon Ranka"
  description="Cjenik usluga Salon Ranka Zagreb. Masaže, kozmetika, depilacija voskom i oblikovanje obrva. Miramarska cesta 24, tel. +385 1 6110 777."
>
  <Header />

  <main id="main-content">

    <!-- Page heading -->
    <section class="pt-40 pb-16 bg-cream" aria-labelledby="cjenik-heading">
      <div class="container-wide text-center">
        <div class="max-w-xl mx-auto fade-up">
          <span class="eyebrow">Salon Ranka</span>
          <h1 id="cjenik-heading" class="heading-lg mb-4">Cjenik usluga</h1>
          <p class="text-stone leading-relaxed">
            Sve cijene su izražene u eurima i uključuju PDV. Za dogovor termina nazovite <a href="tel:+38516110777" class="text-sage-500 hover:underline">+385 1 6110 777</a>.
          </p>
        </div>
      </div>
    </section>

    <!-- Pricing sections -->
    <section class="pb-10 bg-cream" aria-label="Cjenik po kategorijama">
      <div class="container-wide">
        <div class="max-w-2xl mx-auto space-y-6">

          {categories.map((cat, ci) => (
            <div
              id={cat.id}
              class={`rounded-xl border border-pebble bg-white overflow-hidden fade-up fade-up-delay-${Math.min(ci + 1, 4)}`}
            >
              <!-- Category header -->
              <div class="px-6 py-4 border-b border-pebble bg-sage-50">
                <h2 class="text-sm font-semibold tracking-widest uppercase text-sage-600">
                  {cat.naslov}
                </h2>
              </div>

              <!-- Rows -->
              <table class="w-full" aria-label={`Cijene za ${cat.naslov}`}>
                <caption class="sr-only">Cjenik — {cat.naslov}</caption>
                <thead class="sr-only">
                  <tr>
                    <th scope="col">Usluga</th>
                    <th scope="col">Trajanje</th>
                    <th scope="col">Cijena</th>
                  </tr>
                </thead>
                <tbody>
                  {cat.usluge.map((item, i) => (
                    <tr class={`border-b border-pebble last:border-0 ${i % 2 === 0 ? '' : 'bg-cream/60'}`}>
                      <td class="py-3.5 px-6 text-sm text-charcoal font-medium">
                        {item.naziv}
                        {item.posebni_oblik_prodaje && (
                          <span class="ml-2 inline-block rounded-full bg-sage-500 px-2 py-0.5 text-[0.65rem] font-semibold uppercase tracking-wider text-white align-middle">
                            {item.naziv_posebnog_oblika}
                          </span>
                        )}
                      </td>
                      <td class="py-3.5 px-4 text-sm text-stone text-center whitespace-nowrap">
                        {item.trajanje ?? ''}
                      </td>
                      <td class="py-3.5 px-6 text-right">
                        <span class="block text-sm font-semibold text-sage-600 whitespace-nowrap">
                          {formatCijena(item.cijena)} €
                        </span>
                        <span class="block text-[0.7rem] leading-snug text-stone">
                          (sidrena cijena na dan {sidreniDatum}: {formatCijena(item.sidrena_cijena)} €)
                        </span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ))}

          <!-- Note -->
          <p class="text-xs text-stone text-center pt-2 fade-up">
            Cijene su podložne promjenama. Za više informacija nazovite <a href="tel:+38516110777" class="text-sage-500 hover:underline">+385 1 6110 777</a>.
          </p>
          <p class="text-xs text-stone text-center fade-up">
            Sidrena cijena je cijena usluge na dan {sidreniDatum} Strojno čitljivi cjenici dostupni su na stranici <a href="/cjenici" class="text-sage-500 hover:underline">Cjenici</a>.
          </p>

        </div>
      </div>
    </section>

    <CtaBanner
      headline="Rezervirajte svoj tretman"
      subhead="Nazovite nas i dogovorite termin koji vam odgovara."
      ctaLabel="Nazovite +385 1 6110 777"
      mt="mt-10"
    />

  </main>

  <Footer />
  <StickyCallButton />
</Layout>
